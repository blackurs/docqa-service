# Production defaults (APP_ENV=prod). No secrets here — only non-sensitive
# operational settings. The API key must come from the real environment
# (systemd/k8s secret, CI variable, etc.) or from an untracked .env.
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=5000
LLM_PROVIDER=openai
FALLBACK_ENABLED=true
