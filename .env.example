# ---------------------------------------------------------------------------
# docqa-service — template for local configuration.
# Copy to .env and adjust values:  cp .env.example .env
# NEVER commit a real .env (it is ignored by .gitignore).
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
# dev | test | prod (prod forbids the mock provider)
APP_ENV=dev
APP_NAME=docqa-service
APP_HOST=127.0.0.1
APP_PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
# json | text
APP_LOG_FORMAT=json
# Maximum accepted HTTP body size in bytes
APP_MAX_REQUEST_BYTES=262144

# --- LLM provider ---------------------------------------------------------
# mock | openai  (openai = any OpenAI-compatible API: OpenAI, GigaChat proxy,
# YandexGPT proxy, vLLM, Ollama, etc. — just set LLM_BASE_URL and LLM_MODEL)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=400

# --- Mock provider (for local demo / CI, no network required) --------------
MOCK_LATENCY_MS=0
# none | timeout | error | empty
MOCK_FAIL_MODE=none

# --- Cache ----------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

# --- Business limits ------------------------------------------------------
FALLBACK_ENABLED=true
MIN_QUESTION_CHARS=3
MAX_QUESTION_CHARS=500
MAX_CONTEXT_CHARS=20000
TOP_K_EXCERPTS=4
MAX_EXCERPT_CHARS=1200
MAX_ANSWER_CHARS=2000
